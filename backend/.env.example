# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq AI for post-assessment analysis and roadmap generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Every configured model receives the full assessment prompt. Successful
# responses are merged into one detailed analysis.
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b,qwen/qwen3.8-27b,groq/compound-mini,groq/compound

# OpenRouter AI roadmap generation (keep the real key only in .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional comma-separated fallback list; every entry must be an OpenRouter :free model.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,deepseek/deepseek-r1-0528:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# JWT Configuration
JWT_SECRET=

# CORS - deployed frontend origin (Vercel URL)
FRONTEND_URL=https://sih-one-amber.vercel.app

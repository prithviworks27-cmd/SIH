# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter AI roadmap generation (keep the real key only in .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# JWT Configuration
JWT_SECRET=

# CORS - deployed frontend origin (Vercel URL)
FRONTEND_URL=https://sih-one-amber.vercel.app
